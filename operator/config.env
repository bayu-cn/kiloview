# Halaman operator. Dengarkan di semua interface, port ini tidak bentrok dengan KiloLink (80).
BIND=0.0.0.0
PORT=8090
PUBLIC_URL=http://172.17.20.46:8090

# Gambar sumber lewat WebRTC (8889). Suara monitor SDI juga lewat port ini,
# karena preview slot dipublish ulang sebagai H.264 + Opus.
MEDIAMTX_PUBLIC=http://172.17.20.46:8888
MEDIAMTX_WEBRTC=http://172.17.20.46:8889
MEDIAMTX_API=http://127.0.0.1:9997
RTSP_BASE=rtsp://127.0.0.1:8554
SOURCES=p3-1,p3-2,p3-3,p3-4

# Login Keycloak. Kosongkan secret kalau belum siap: halaman tetap bisa dibuka di LAN.
# Isi keempat nilai ini untuk mengaktifkan login.
# Client Keycloak: confidential, standard flow.
# Valid redirect URI: http://172.17.20.46:8090/callback
# Web origins: http://172.17.20.46:8090
# Realm role yang boleh masuk: admin, operator-feeddesk
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=operator
KEYCLOAK_CLIENT_SECRET=
ALLOWED_ROLES=admin,operator-feeddesk
